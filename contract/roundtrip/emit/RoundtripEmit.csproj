<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RoundtripEmit</AssemblyName>
    <RootNamespace>Haruki3D.Contract.Roundtrip</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the exporter's PRODUCTION MessagePack/ext-42 writer in place; never copy it. -->
    <Compile Include="../../../exporter/Services/RuntimeJsonWriter.cs" />
  </ItemGroup>

</Project>
